# Copy to .env and fill in. .env is ignored by git; never commit real values.
DB_NAME=intellhub
DB_USER=intellhub
DB_PASSWORD=change-me
DB_PORT=5432

# Auth
# JWT signing secret: at least 32 characters, e.g. `openssl rand -hex 32`. The app will not start without it,
# or while it still contains "change-me".
JWT_SECRET=change-me-to-a-long-random-value-of-32-chars-or-more
# First administrator, created on first start only while no users exist. Password: 12 to 72 characters;
# the app will not start while it still contains "change-me".
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional: set COOKIE_SECURE=true when serving over HTTPS; ALLOWED_ORIGINS is a comma-separated list
# of browser origins allowed to call refresh and logout (default http://localhost:5173).
# COOKIE_SECURE=false
# ALLOWED_ORIGINS=http://localhost:5173

# Sources: add the starter RSS feeds on first start, only while there are no sources (default true).
# SEED_DEFAULT_SOURCES=true

# Ingestion
# Shared secret for POST /internal/ingest, sent as the X-Ingest-Token header. At least 32 characters,
# for example `openssl rand -hex 32`. Leave it unset and the endpoint refuses every call. The app will not
# start if this still contains "change-me".
# INGEST_SECRET=
# Optional: run ingestion inside the app on a schedule (default false) and the cron for it (default every 4 hours).
# INGEST_SCHEDULE_ENABLED=false
# INGEST_CRON=0 0 */4 * * *

# Enrichment (summaries, tags, relevance). Unset means off: articles stay pending.
# Providers in the order to try them, no spaces: "gemini,groq" (Gemini first, Groq as the fallback), "gemini",
# "groq", or "fake" (an offline stand-in that makes no network call, for trying the pipeline).
# ENRICHMENT_PROVIDER=gemini,groq
# API keys for the providers you list (Google AI Studio and the Groq console). Never commit real values.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# Optional model overrides (defaults shown).
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-20b
# Provider calls per day (default 250), of which this many are only for readers' requests (default 50).
# ENRICHMENT_DAILY_BUDGET=250
# ENRICHMENT_RESERVED_CALLS=50
# The time zone whose midnight starts a new day of budget (default America/Los_Angeles: Gemini's daily quota
# resets at midnight Pacific time).
# ENRICHMENT_BUDGET_ZONE=America/Los_Angeles
